# Storybook production MVP environment sample
# 复制为 .env 后按实际环境修改。

# 服务监听地址
SERVER_ADDR=":8080"

# 认证接口 IP 限流（register/login/refresh），默认 120 次/分、突发 20
# 只防误触连点，不防恶意爆破（那应由网关/反代层负责）
# AUTH_IP_RATE_LIMIT_PER_MIN=120
# AUTH_IP_RATE_LIMIT_BURST=20

# 数据库配置
# 生产建议使用 postgres
DB_DRIVER="postgres"
DB_DSN="host=127.0.0.1 port=5432 user=storybook password=CHANGE_ME dbname=storybook sslmode=disable TimeZone=Asia/Shanghai"

# 如果只是本机临时体验，可改成：
# DB_DRIVER=sqlite
# DB_DSN=storybook.db

# JWT 签名密钥
# 必填，必须替换为强随机值
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# AI 配置加密密钥
# 仅在你要使用管理员 AI 配置持久化时需要
# 必须是 base64 编码后的 32 字节密钥
AI_CONFIG_ENCRYPTION_KEY=""

# 跨域白名单
# 同源嵌入部署时通常留空
# 如果前后端分域部署，可填逗号分隔列表
# 示例: https://storybook.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=""

# 前端独立部署时，下面这个变量需要配置到 storybook-page/.env
# 嵌入同源部署时不需要
# VITE_API_BASE_URL="https://api.example.com"
