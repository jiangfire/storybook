# Storybook production MVP environment sample
# 复制为 .env 后按实际环境修改。

# 服务监听地址
SERVER_ADDR=":8080"

# 数据库配置
# 生产建议使用 postgres
DB_DRIVER="postgres"
DB_DSN="host=127.0.0.1 port=5432 user=storybook password=CHANGE_ME dbname=storybook sslmode=disable TimeZone=Asia/Shanghai"

# 如果只是本机临时体验，可改成：
# DB_DRIVER=sqlite
# DB_DSN=storybook.db

# JWT 签名密钥
# 必填，必须替换为强随机值
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET"

# AI 配置加密密钥
# 仅在你要使用管理员 AI 配置持久化时需要
# 必须是 base64 编码后的 32 字节密钥
AI_CONFIG_ENCRYPTION_KEY=""

# AI 运行配置说明
# 当前代码不会从环境变量读取 OpenAI API Key / Base URL / Model / Temperature / Max Tokens。
# 这些配置需要管理员登录后在 /admin/ai 页面中维护，并加密存储到数据库。
#
# 当前真正生效的 AI 相关环境变量只有：
# AI_CONFIG_ENCRYPTION_KEY
#
# 如果你后面想改成环境变量直配，可以预留这些名字，但现在不会生效：
# OPENAI_API_KEY=""
# OPENAI_BASE_URL=""
# OPENAI_MODEL="gpt-4o-mini"
# OPENAI_TEMPERATURE="0.2"
# OPENAI_MAX_TOKENS="1200"

# 跨域白名单
# 同源嵌入部署时通常留空
# 如果前后端分域部署，可填逗号分隔列表
# 示例: https://storybook.example.com,https://admin.example.com
CORS_ALLOWED_ORIGINS=""

# 前端独立部署时，下面这个变量需要配置到 storybook-page/.env
# 嵌入同源部署时不需要
# VITE_API_BASE_URL="https://api.example.com"
